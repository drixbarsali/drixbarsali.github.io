---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <!-- Core Pages -->
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ '/about.html' | absolute_url }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ '/newsletter.html' | absolute_url }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>{{ '/contact.html' | absolute_url }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ '/privacy.html' | absolute_url }}</loc>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>

  <!-- All Blog Posts & Event Talks (EN, IT, PT-BR) with hreflang links -->
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
    {% if post.ref %}
      {% assign translations = site.posts | where: "ref", post.ref %}
      {% for t in translations %}
    <xhtml:link rel="alternate" hreflang="{{ t.lang | downcase }}" href="{{ t.url | absolute_url }}" />
        {% if t.lang == 'en' %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ t.url | absolute_url }}" />
        {% endif %}
      {% endfor %}
    {% endif %}
  </url>
  {% endfor %}
</urlset>
